# SPDX-License-Identifier: GPL-2.0-only
# Small RM-443 kernel with an embedded diagnostic userspace.
CONFIG_LOCALVERSION="-rm443"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_EXPERT=y
CONFIG_EMBEDDED=y
CONFIG_ARCH_MULTI_V5=y
# CONFIG_ARCH_MULTI_V6 is not set
# CONFIG_ARCH_MULTI_V7 is not set
CONFIG_ARCH_NOKIA_RAPS=y
CONFIG_RM443_INSPECT=y
CONFIG_RM443_PROBE=y
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set
CONFIG_DEBUG_FS=y
CONFIG_ARM_PTDUMP_DEBUGFS=y
CONFIG_PROC_PAGE_MONITOR=y
CONFIG_KALLSYMS=y
CONFIG_MMU=y
CONFIG_COMPACTION=y
CONFIG_AEABI=y
# CONFIG_OABI_COMPAT is not set
# CONFIG_THUMB2_KERNEL is not set
# CONFIG_CPU_BIG_ENDIAN is not set
# CONFIG_SMP is not set
# CONFIG_MODULES is not set
CONFIG_NET=y
CONFIG_INET=y
CONFIG_INET_TABLE_PERTURB_ORDER=8
# CONFIG_IPV6 is not set
# CONFIG_NETFILTER is not set
# CONFIG_WIRELESS is not set
CONFIG_UNIX=y
# CONFIG_PACKET is not set
CONFIG_BLOCK=y
CONFIG_BLK_DEV_WRITE_MOUNTED=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
# CONFIG_PM is not set
# CONFIG_VFP is not set
# CONFIG_ATAGS is not set
CONFIG_ARM_PATCH_PHYS_VIRT=y
# CONFIG_AUTO_ZRELADDR is not set
CONFIG_PHYS_OFFSET=0x0
CONFIG_OF=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_RM443=y
CONFIG_DMADEVICES=y
CONFIG_RAPS_DMA=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_DEVICE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER is not set
# CONFIG_LOGO is not set
CONFIG_PRINTK=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_LOG_BUF_SHIFT=15
CONFIG_PANIC_TIMEOUT=0
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_DEBUG_INFO is not set
# CONFIG_FTRACE is not set
CONFIG_DEBUG_KERNEL=y
CONFIG_CMDLINE=""
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="/work/initramfs/root.list"
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MULTIUSER=y
CONFIG_COMPAT_32BIT_TIME=y
# CONFIG_PRINTK_TIME is not set
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_FONT_SUPPORT=y
CONFIG_FONT_8x16=y
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_NOWAYOUT=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_WATCHDOG_OPEN_TIMEOUT=0
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_CDC_COMPOSITE=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_USB_GADGET_VBUS_DRAW=2
CONFIG_UNIX98_PTYS=y
CONFIG_SIGNALFD=y
